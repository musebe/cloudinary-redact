# Server-only Cloudinary credentials. Never expose the API secret to browser code.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Advanced OCR is designed for screenshots, photos, and graphics containing text.
CLOUDINARY_OCR_MODE=adv_ocr

# Keep the local API below the hosting platform's request limit.
MAX_UPLOAD_BYTES=4000000
